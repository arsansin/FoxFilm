<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear27"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="8dp"
		android:padding="8dp"
		android:background="#0F1620"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:stateListAnimator="@anim/alpha_animator">
		<androidx.cardview.widget.CardView
			android:id="@+id/cardview1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardElevation="2dp"
			app:cardCornerRadius="20dp">
			<LinearLayout
				android:id="@+id/linear32"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/line1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/img0"
						android:focusable="false"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:background="#000000"
						android:src="@drawable/back"
						android:scaleType="fitXY"
						android:layout_weight="1" />
					<ImageView
						android:id="@+id/img1"
						android:focusable="false"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:background="#000000"
						android:src="@drawable/back"
						android:scaleType="fitXY"
						android:layout_weight="1" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear30"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/img2"
						android:focusable="false"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:background="#000000"
						android:src="@drawable/back"
						android:scaleType="fitXY"
						android:layout_weight="1" />
					<ImageView
						android:id="@+id/img3"
						android:focusable="false"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:background="#000000"
						android:src="@drawable/back"
						android:scaleType="fitXY"
						android:layout_weight="1" />
				</LinearLayout>
			</LinearLayout>
		</androidx.cardview.widget.CardView>
		<LinearLayout
			android:id="@+id/linear31"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/imageview20"
				android:focusable="false"
				android:layout_width="25dp"
				android:layout_height="25dp"
				android:src="@drawable/ic_chevron_left_white"
				android:scaleType="fitCenter" />
			<TextView
				android:id="@+id/title_per"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="انیمیشن"
				android:textSize="16sp"
				android:textColor="#FFFFFF"
				android:singleLine="true"
				android:layout_weight="1" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
