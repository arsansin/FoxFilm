<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear76"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/hashtag_new"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:layout_marginBottom="8dp"
			android:gravity="right|center_vertical"
			android:orientation="horizontal"
			android:stateListAnimator="@anim/alpha_animator">
			<ImageView
				android:id="@+id/imageview63"
				android:focusable="false"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:src="@drawable/ic_chevron_left_white"
				android:scaleType="fitCenter" />
			<TextView
				android:id="@+id/textview15"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="8dp"
				android:paddingRight="10dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="جدیدترین ها"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
		</LinearLayout>
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recyclerview2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="10dp"
			android:rotation="180"
			tools:listitem="@layout/cus" />
	</LinearLayout>
	<RelativeLayout
		android:id="@+id/relativelayout7"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp">
		<LinearLayout
			android:id="@+id/linear214"
			android:layout_width="match_parent"
			android:layout_height="100dp"
			android:orientation="vertical">
			<androidx.cardview.widget.CardView
				android:id="@+id/cardview4"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:cardElevation="2dp"
				app:cardCornerRadius="20dp">
				<LinearLayout
					android:id="@+id/linear215"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical">
					<androidx.viewpager.widget.ViewPager
						android:id="@+id/slider1"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="8dp" />
				</LinearLayout>
			</androidx.cardview.widget.CardView>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear216"
			android:layout_width="match_parent"
			android:layout_height="100dp"
			android:padding="8dp"
			android:gravity="center_horizontal|bottom"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear217"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear218"
					android:layout_width="35dp"
					android:layout_height="35dp"
					android:background="#000000"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical">
					<ImageView
						android:id="@+id/imageview92"
						android:focusable="false"
						android:layout_width="25dp"
						android:layout_height="25dp"
						android:src="@drawable/ic_chevron_left_white"
						android:scaleType="fitCenter" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear219"
					android:layout_width="35dp"
					android:layout_height="35dp"
					android:layout_marginLeft="5dp"
					android:background="#000000"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical">
					<ImageView
						android:id="@+id/imageview93"
						android:focusable="false"
						android:layout_width="25dp"
						android:layout_height="25dp"
						android:src="@drawable/next1"
						android:scaleType="fitCenter" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
	<RelativeLayout
		android:id="@+id/relativelayout5"
		android:layout_width="match_parent"
		android:layout_height="200dp"
		android:layout_marginTop="20dp"
		android:layout_marginBottom="20dp">
		<ImageView
			android:id="@+id/imageview1"
			android:focusable="false"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:src="@drawable/nul"
			android:scaleType="centerCrop" />
		<LinearLayout
			android:id="@+id/linear213"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="8dp"
			android:gravity="right|bottom"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="25dp"
				android:layout_height="25dp"
				android:background="#000000"
				android:gravity="right|bottom"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/imageview2"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:src="@drawable/age_group_5"
					android:scaleType="fitCenter" />
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
	<RelativeLayout
		android:id="@+id/relativelayout2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<androidx.viewpager.widget.ViewPager
			android:id="@+id/viewpager1"
			android:layout_width="match_parent"
			android:layout_height="450dp"
			android:rotation="180"
			tools:listitem="@layout/sddf" />
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="match_parent"
			android:layout_height="450dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear12"
				android:layout_width="match_parent"
				android:layout_height="70dp"
				android:background="@drawable/linobarhajs"
				android:gravity="center_horizontal|bottom"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear92"
					android:layout_width="30dp"
					android:layout_height="30dp"
					android:layout_marginLeft="10dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_gravity="bottom"
					android:stateListAnimator="@anim/alpha_animator">
					<ImageView
						android:id="@+id/imageview43"
						android:focusable="false"
						android:layout_width="22dp"
						android:layout_height="22dp"
						android:src="@drawable/icon_report_outline"
						android:scaleType="fitCenter"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/lin_kids"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="3dp"
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_weight="1">
					<TextView
						android:id="@+id/text_kids"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="30dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="کودک"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
					<ImageView
						android:id="@+id/imageview59"
						android:focusable="false"
						android:layout_width="15dp"
						android:layout_height="15dp"
						android:layout_marginLeft="3dp"
						android:src="@drawable/ic_cancel_grey"
						android:scaleType="fitCenter"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/lin_series"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="3dp"
					android:layout_marginRight="3dp"
					android:paddingLeft="5dp"
					android:paddingRight="5dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_weight="1">
					<TextView
						android:id="@+id/text_sieres"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="30dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="سریال‌ها"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
					<ImageView
						android:id="@+id/imageview60"
						android:focusable="false"
						android:layout_width="15dp"
						android:layout_height="15dp"
						android:layout_marginLeft="3dp"
						android:src="@drawable/ic_cancel_grey"
						android:scaleType="fitCenter" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/lin_movie"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="3dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_weight="1">
					<TextView
						android:id="@+id/text_movies"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="30dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="فیلم‌ها"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
					<ImageView
						android:id="@+id/imageview61"
						android:focusable="false"
						android:layout_width="15dp"
						android:layout_height="15dp"
						android:layout_marginLeft="3dp"
						android:src="@drawable/ic_cancel_grey"
						android:scaleType="fitCenter" />
				</LinearLayout>
				<TextView
					android:id="@+id/textview37"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="30dp"
					android:paddingLeft="30dp"
					android:paddingRight="10dp"
					android:gravity="right|center_vertical"
					android:text="فاکس فیلم"
					android:textSize="20sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:layout_gravity="bottom" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear5"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|bottom"
				android:orientation="horizontal"
				android:layout_weight="1" />
			<LinearLayout
				android:id="@+id/linear10"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|bottom"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear182"
					android:layout_width="match_parent"
					android:layout_height="70dp"
					android:background="@drawable/lino"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical">
					<RelativeLayout
						android:id="@+id/relativelayout4"
						android:layout_width="match_parent"
						android:layout_height="45dp"
						android:layout_marginLeft="70dp"
						android:layout_marginRight="70dp"
						android:padding="1dp">
						<LinearLayout
							android:id="@+id/linear207"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical">
							<androidx.cardview.widget.CardView
								android:id="@+id/cardview3"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								app:cardElevation="0dp"
								app:cardCornerRadius="999dp">
								<LinearLayout
									android:id="@+id/linear206"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:orientation="vertical">
									<ImageView
										android:id="@+id/imageview91"
										android:focusable="false"
										android:layout_width="match_parent"
										android:layout_height="match_parent"
										android:src="@drawable/nul"
										android:scaleType="center" />
								</LinearLayout>
							</androidx.cardview.widget.CardView>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear6"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal">
							<TextView
								android:id="@+id/textview107"
								android:focusable="false"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="پخش فیلم"
								android:textSize="14sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF" />
							<ImageView
								android:id="@+id/imageview64"
								android:focusable="false"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:src="@drawable/play_2"
								android:scaleType="fitCenter" />
						</LinearLayout>
					</RelativeLayout>
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/rec_positions"
						android:layout_width="wrap_content"
						android:layout_height="20dp"
						android:layout_marginLeft="10dp"
						android:layout_marginRight="10dp"
						android:layout_marginBottom="5dp"
						android:rotation="180"
						android:layout_gravity="center_horizontal|center_vertical"
						tools:listitem="@layout/position" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
</LinearLayout>
