<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#0F1620"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear92"
			android:layout_width="match_parent"
			android:layout_height="85dp"
			android:layout_marginLeft="8dp"
			android:layout_marginRight="8dp"
			android:paddingBottom="10dp"
			android:gravity="center_horizontal|bottom"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear89"
				android:layout_width="35dp"
				android:layout_height="35dp"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical" />
			<TextView
				android:id="@+id/textview1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="5dp"
				android:padding="4dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="بیشتر"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:singleLine="true"
				android:layout_weight="1" />
			<LinearLayout
				android:id="@+id/linear90"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:background="#1D2733"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<ImageView
					android:id="@+id/setting"
					android:layout_width="25dp"
					android:layout_height="25dp"
					android:src="@drawable/ic_chevron_left_white"
					android:scaleType="fitCenter"
					android:rotation="180" />
			</LinearLayout>
		</LinearLayout>
		<RelativeLayout
			android:id="@+id/relativelayout2"
			android:layout_width="match_parent"
			android:layout_height="match_parent">
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerView1"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:overScrollMode="never"
				android:fillViewport="true"
				android:fadingEdgeLength="10dp"
				android:requiresFadingEdge="vertical"
				android:fadeScrollbars="false"
				tools:listitem="@layout/sus" />
			<LinearLayout
				android:id="@+id/linear65"
				android:layout_width="match_parent"
				android:layout_height="285dp"
				android:paddingTop="28dp"
				android:background="#0F1620"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:alpha="0.9">
				<TextView
					android:id="@+id/love"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:padding="8dp"
					android:text="0"
					android:textSize="12sp"
					android:textColor="#000000" />
				<TextView
					android:id="@+id/cuple"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:padding="8dp"
					android:text="0"
					android:textSize="12sp"
					android:textColor="#000000" />
				<androidx.cardview.widget.CardView
					android:id="@+id/cardview1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_horizontal|center_vertical">
					<RelativeLayout
						android:id="@+id/relativelayout1"
						android:layout_width="match_parent"
						android:layout_height="wrap_content">
						<ImageView
							android:id="@+id/imageview2"
							android:layout_width="100dp"
							android:layout_height="175dp"
							android:src="@drawable/shaderbottom"
							android:scaleType="centerCrop" />
						<LinearLayout
							android:id="@+id/linear3"
							android:layout_width="100dp"
							android:layout_height="175dp"
							android:padding="8dp"
							android:gravity="right|bottom"
							android:orientation="vertical"
							android:stateListAnimator="@anim/alpha_animator">
							<LinearLayout
								android:id="@+id/linear6"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:orientation="horizontal"
								android:layout_weight="1" />
							<LinearLayout
								android:id="@+id/linear4"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:background="#000000"
								android:gravity="right|bottom"
								android:orientation="horizontal">
								<ImageView
									android:id="@+id/imageview3"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_margin="7dp"
									android:src="@drawable/age_group_5"
									android:scaleType="fitCenter" />
							</LinearLayout>
						</LinearLayout>
					</RelativeLayout>
				</androidx.cardview.widget.CardView>
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="104dp"
					android:layout_height="wrap_content"
					android:layout_marginBottom="4dp"
					android:gravity="right|center_vertical"
					android:orientation="horizontal"
					android:layout_gravity="center_horizontal|center_vertical">
					<TextView
						android:id="@+id/name"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="4dp"
						android:gravity="center_horizontal|center_vertical"
						android:textSize="11sp"
						android:textColor="#FFFFFF"
						android:singleLine="true"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
			</LinearLayout>
		</RelativeLayout>
		<ProgressBar
			android:id="@+id/progressbar1"
			android:layout_width="match_parent"
			android:layout_height="5dp"
			android:indeterminate="true"
			style="?android:progressBarStyleHorizontal" />
	</LinearLayout>
</LinearLayout>
