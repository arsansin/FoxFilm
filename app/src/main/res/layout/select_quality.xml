<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal"
		android:layout_weight="1">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="320dp"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:background="#0F1620"
			android:orientation="vertical"
			android:layout_gravity="center_horizontal|center_vertical"
			android:layout_weight="1">
			<LinearLayout
				android:id="@+id/linear8"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="5dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview6"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:gravity="center_horizontal|center_vertical"
					android:text="به بالا بکشید"
					android:textSize="10sp"
					android:textColor="#ECEFF1" />
				<TextView
					android:id="@+id/textview5"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="برای انتخاب کیفیت ویدیو"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:layout_gravity="center_horizontal|center_vertical" />
			</LinearLayout>
			<ScrollView
				android:id="@+id/vscroll1"
				android:layout_width="match_parent"
				android:layout_height="match_parent">
				<LinearLayout
					android:id="@+id/linear9"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/lin1"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal"
						android:stateListAnimator="@anim/alpha_animator">
						<ImageView
							android:id="@+id/tick480"
							android:focusable="false"
							android:layout_width="15dp"
							android:layout_height="15dp"
							android:layout_marginLeft="20dp"
							android:src="@drawable/ic_check_white"
							android:scaleType="fitCenter" />
						<TextView
							android:id="@+id/textview1"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="right"
							android:text="480pکیفیت "
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF"
							android:layout_weight="1" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear3"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="#1D2733"
						android:orientation="horizontal"
						android:scaleY="0.7" />
					<LinearLayout
						android:id="@+id/lin2"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal"
						android:stateListAnimator="@anim/alpha_animator">
						<ImageView
							android:id="@+id/tick720"
							android:focusable="false"
							android:layout_width="15dp"
							android:layout_height="15dp"
							android:layout_marginLeft="20dp"
							android:src="@drawable/ic_check_white"
							android:scaleType="fitCenter" />
						<TextView
							android:id="@+id/textview3"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="right"
							android:text="720pکیفیت "
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF"
							android:layout_weight="1" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="#1D2733"
						android:orientation="horizontal"
						android:scaleY="0.7" />
					<LinearLayout
						android:id="@+id/lin3"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal"
						android:stateListAnimator="@anim/alpha_animator">
						<ImageView
							android:id="@+id/tick1080"
							android:focusable="false"
							android:layout_width="15dp"
							android:layout_height="15dp"
							android:layout_marginLeft="20dp"
							android:src="@drawable/ic_check_white"
							android:scaleType="fitCenter" />
						<TextView
							android:id="@+id/textview4"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="right"
							android:text="1080pکیفیت "
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF"
							android:layout_weight="1" />
					</LinearLayout>
				</LinearLayout>
			</ScrollView>
			<zakfilm.ir.ExpandableRecyclerView
				android:id="@+id/recyclerview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal|center_vertical" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/close"
			android:layout_width="50dp"
			android:layout_height="50dp"
			android:layout_marginLeft="6dp"
			android:background="#0F1620"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:stateListAnimator="@anim/alpha_animator">
			<ImageView
				android:id="@+id/imageview1"
				android:focusable="false"
				android:layout_width="30dp"
				android:layout_height="30dp"
				android:src="@drawable/icon_close_round"
				android:scaleType="fitCenter" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
