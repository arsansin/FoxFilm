<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<androidx.cardview.widget.CardView
		android:id="@+id/cardview2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		app:cardElevation="10dp"
		app:cardCornerRadius="20dp">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="20dp"
			android:background="#222327"
			android:gravity="right|top"
			android:orientation="vertical">
			<RelativeLayout
				android:id="@+id/relativelayout1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">
				<ImageView
					android:id="@+id/background"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="100dp"
					android:src="@drawable/default_image"
					android:scaleType="centerCrop" />
				<LinearLayout
					android:id="@+id/linear6"
					android:layout_width="match_parent"
					android:layout_height="100dp"
					android:background="#000000"
					android:gravity="right|center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview11"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:paddingLeft="8dp"
						android:paddingTop="5dp"
						android:paddingRight="8dp"
						android:paddingBottom="5dp"
						android:background="#FFC107"
						android:text="بلیط دانلود: 0"
						android:textSize="11sp"
						android:textColor="#FFFFFF" />
					<TextView
						android:id="@+id/title"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="50dp"
						android:layout_margin="10dp"
						android:gravity="right|center_vertical"
						android:text="فیلم سینمایی"
						android:textSize="18sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:layout_weight="1" />
					<androidx.cardview.widget.CardView
						android:id="@+id/cardview1"
						android:layout_width="50dp"
						android:layout_height="65dp"
						android:layout_marginRight="10dp"
						app:cardElevation="10dp"
						app:cardCornerRadius="20dp">
						<ImageView
							android:id="@+id/poster"
							android:focusable="false"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:src="@drawable/default_image"
							android:scaleType="centerCrop" />
					</androidx.cardview.widget.CardView>
				</LinearLayout>
			</RelativeLayout>
			<LinearLayout
				android:id="@+id/linear2"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="#455A64"
				android:orientation="horizontal" />
			<ScrollView
				android:id="@+id/vscroll1"
				android:layout_width="match_parent"
				android:layout_height="match_parent">
				<LinearLayout
					android:id="@+id/linear11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview10"
						android:focusable="false"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:layout_marginTop="10dp"
						android:layout_marginRight="10dp"
						android:text="انتخاب کیفیت:"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
					<LinearLayout
						android:id="@+id/l1080"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:layout_marginTop="5dp"
						android:layout_marginRight="10dp"
						android:layout_marginBottom="5dp"
						android:background="#4C4F56"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical"
						android:stateListAnimator="@anim/alpha_animator">
						<LinearLayout
							android:id="@+id/linear13"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/size_1080"
								android:focusable="false"
								android:layout_width="wrap_content"
								android:layout_height="35dp"
								android:layout_marginLeft="5dp"
								android:layout_marginTop="5dp"
								android:layout_marginBottom="5dp"
								android:paddingLeft="3dp"
								android:paddingTop="1dp"
								android:paddingRight="3dp"
								android:paddingBottom="1dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="          "
								android:textSize="10sp"
								android:textStyle="bold"
								android:textColor="#000000" />
						</LinearLayout>
						<TextView
							android:id="@+id/textview2"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="5dp"
							android:text="1080p"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
						<LinearLayout
							android:id="@+id/linear12"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="right|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<LinearLayout
								android:id="@+id/linear14"
								android:layout_width="35dp"
								android:layout_height="35dp"
								android:layout_marginTop="5dp"
								android:layout_marginRight="5dp"
								android:layout_marginBottom="5dp"
								android:background="#FFFFFF"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="vertical">
								<ImageView
									android:id="@+id/imageview1"
									android:focusable="false"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:src="@drawable/icon_copy_all_round"
									android:scaleType="fitCenter" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/l720"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:layout_marginRight="10dp"
						android:layout_marginBottom="5dp"
						android:background="#4C4F56"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical"
						android:stateListAnimator="@anim/alpha_animator">
						<LinearLayout
							android:id="@+id/linear15"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/size_720"
								android:focusable="false"
								android:layout_width="wrap_content"
								android:layout_height="35dp"
								android:layout_marginLeft="5dp"
								android:layout_marginTop="5dp"
								android:layout_marginBottom="5dp"
								android:paddingLeft="3dp"
								android:paddingTop="1dp"
								android:paddingRight="3dp"
								android:paddingBottom="1dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="          "
								android:textSize="10sp"
								android:textStyle="bold"
								android:textColor="#000000" />
						</LinearLayout>
						<TextView
							android:id="@+id/textview3"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="5dp"
							android:text="720p"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
						<LinearLayout
							android:id="@+id/linear16"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="right|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<LinearLayout
								android:id="@+id/linear17"
								android:layout_width="35dp"
								android:layout_height="35dp"
								android:layout_marginTop="5dp"
								android:layout_marginRight="5dp"
								android:layout_marginBottom="5dp"
								android:background="#FFFFFF"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="vertical">
								<ImageView
									android:id="@+id/imageview2"
									android:focusable="false"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:src="@drawable/icon_copy_all_round"
									android:scaleType="fitCenter" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/l480"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:layout_marginRight="10dp"
						android:layout_marginBottom="8dp"
						android:background="#FF5252"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical"
						android:stateListAnimator="@anim/alpha_animator">
						<LinearLayout
							android:id="@+id/linear18"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/size_480"
								android:focusable="false"
								android:layout_width="wrap_content"
								android:layout_height="35dp"
								android:layout_marginLeft="5dp"
								android:layout_marginTop="5dp"
								android:layout_marginBottom="5dp"
								android:paddingLeft="3dp"
								android:paddingTop="1dp"
								android:paddingRight="3dp"
								android:paddingBottom="1dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="          "
								android:textSize="10sp"
								android:textStyle="bold"
								android:textColor="#000000" />
						</LinearLayout>
						<TextView
							android:id="@+id/textview4"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="5dp"
							android:text="480p"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
						<LinearLayout
							android:id="@+id/linear21"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="right|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<LinearLayout
								android:id="@+id/linear22"
								android:layout_width="35dp"
								android:layout_height="35dp"
								android:layout_marginTop="5dp"
								android:layout_marginRight="5dp"
								android:layout_marginBottom="5dp"
								android:background="#FFFFFF"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="vertical">
								<ImageView
									android:id="@+id/imageview4"
									android:focusable="false"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:src="@drawable/icon_copy_all_round"
									android:scaleType="fitCenter" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/recyclerview1"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						tools:listitem="@layout/download_quality" />
					<TextView
						android:id="@+id/textview7"
						android:focusable="false"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:layout_marginRight="10dp"
						android:layout_marginBottom="5dp"
						android:text="دانلود با:"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:layout_weight="1" />
					<LinearLayout
						android:id="@+id/linear10"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:layout_marginRight="10dp"
						android:layout_marginBottom="10dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/dl_1"
							android:layout_width="wrap_content"
							android:layout_height="35dp"
							android:layout_marginLeft="10dp"
							android:layout_marginRight="3dp"
							android:paddingLeft="8dp"
							android:paddingTop="1dp"
							android:paddingRight="8dp"
							android:paddingBottom="1dp"
							android:background="#4C4F56"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal"
							android:layout_gravity="center_horizontal|center_vertical"
							android:stateListAnimator="@anim/alpha_animator">
							<TextView
								android:id="@+id/textview8"
								android:focusable="false"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="دانلود با برنامه ADM"
								android:textSize="12sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/dl_0"
							android:layout_width="wrap_content"
							android:layout_height="35dp"
							android:paddingLeft="8dp"
							android:paddingTop="1dp"
							android:paddingRight="8dp"
							android:paddingBottom="1dp"
							android:background="#FF5252"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal"
							android:layout_gravity="center_horizontal|center_vertical"
							android:stateListAnimator="@anim/alpha_animator">
							<TextView
								android:id="@+id/textview9"
								android:focusable="false"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="دانلودر گوشی (مستقیم)"
								android:textSize="12sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</ScrollView>
			<LinearLayout
				android:id="@+id/linear9"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:padding="8dp"
				android:background="#455A64"
				android:orientation="horizontal" />
			<LinearLayout
				android:id="@+id/btn_start"
				android:layout_width="match_parent"
				android:layout_height="40dp"
				android:layout_marginLeft="10dp"
				android:layout_marginTop="10dp"
				android:layout_marginRight="10dp"
				android:layout_marginBottom="5dp"
				android:background="#448AFF"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical"
				android:stateListAnimator="@anim/alpha_animator">
				<TextView
					android:id="@+id/textview6"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="شروع دانلود"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
			</LinearLayout>
		</LinearLayout>
	</androidx.cardview.widget.CardView>
</LinearLayout>
