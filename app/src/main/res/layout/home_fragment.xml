<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<RelativeLayout
		android:id="@+id/relativelayout1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<LinearLayout
			android:id="@+id/linear9"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#0F1620"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear173"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_weight="1">
				<LinearLayout
					android:id="@+id/linear3"
					android:layout_width="match_parent"
					android:layout_height="450dp"
					android:paddingLeft="8dp"
					android:paddingTop="8dp"
					android:paddingRight="8dp"
					android:paddingBottom="20dp"
					android:gravity="center_horizontal|bottom"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/null1"
						android:layout_width="match_parent"
						android:layout_height="250dp"
						android:layout_marginLeft="30dp"
						android:layout_marginRight="30dp"
						android:padding="1dp"
						android:background="#1D2733"
						android:orientation="vertical" />
					<LinearLayout
						android:id="@+id/null2"
						android:layout_width="match_parent"
						android:layout_height="45dp"
						android:layout_marginLeft="70dp"
						android:layout_marginTop="40dp"
						android:layout_marginRight="70dp"
						android:padding="1dp"
						android:background="#1D2733"
						android:orientation="vertical" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear76"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/hashtag_new"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:layout_marginBottom="8dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal"
						android:stateListAnimator="@anim/alpha_animator">
						<LinearLayout
							android:id="@+id/null3"
							android:layout_width="100dp"
							android:layout_height="25dp"
							android:padding="8dp"
							android:background="#1D2733"
							android:orientation="horizontal" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear179"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="right|center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/nul7"
							android:layout_width="100dp"
							android:layout_height="185dp"
							android:layout_marginLeft="10dp"
							android:background="#1D2733"
							android:gravity="center_horizontal|bottom"
							android:orientation="vertical" />
						<LinearLayout
							android:id="@+id/nul6"
							android:layout_width="100dp"
							android:layout_height="185dp"
							android:layout_marginLeft="10dp"
							android:background="#1D2733"
							android:gravity="center_horizontal|bottom"
							android:orientation="vertical">
							<androidx.viewpager.widget.ViewPager
								android:id="@+id/slider1"
								android:layout_width="0dp"
								android:layout_height="0dp"
								android:padding="8dp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/nul5"
							android:layout_width="100dp"
							android:layout_height="185dp"
							android:layout_marginLeft="10dp"
							android:background="#1D2733"
							android:gravity="center_horizontal|bottom"
							android:orientation="vertical" />
						<LinearLayout
							android:id="@+id/nul4"
							android:layout_width="100dp"
							android:layout_height="185dp"
							android:layout_marginLeft="10dp"
							android:background="#1D2733"
							android:gravity="center_horizontal|bottom"
							android:orientation="vertical" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				tools:listitem="@layout/main_lists" />
			<androidx.viewpager.widget.ViewPager
				android:id="@+id/viewpager1"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp" />
			<ProgressBar
				android:id="@+id/progressbar1"
				android:layout_width="match_parent"
				android:layout_height="8dp"
				android:indeterminate="true"
				style="?android:progressBarStyleHorizontal" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear87"
			android:layout_width="match_parent"
			android:layout_height="80dp"
			android:paddingLeft="10dp"
			android:paddingRight="10dp"
			android:paddingBottom="13dp"
			android:background="#0F1620"
			android:gravity="right|bottom"
			android:orientation="horizontal"
			android:alpha="0.8">
			<LinearLayout
				android:id="@+id/linear172"
				android:layout_width="30dp"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:stateListAnimator="@anim/alpha_animator">
				<ImageView
					android:id="@+id/imageview58"
					android:layout_width="30dp"
					android:layout_height="23dp"
					android:src="@drawable/icon_report_outline"
					android:scaleType="fitCenter"
					android:layout_gravity="center_horizontal|center_vertical" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/lin_kids"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="3dp"
				android:paddingLeft="5dp"
				android:paddingRight="5dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_weight="1">
				<TextView
					android:id="@+id/textview94"
					android:layout_width="wrap_content"
					android:layout_height="30dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="کودک"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
				<ImageView
					android:id="@+id/imageview59"
					android:layout_width="15dp"
					android:layout_height="15dp"
					android:layout_marginLeft="3dp"
					android:src="@drawable/ic_cancel_grey"
					android:scaleType="fitCenter"
					android:layout_gravity="center_horizontal|center_vertical" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/lin_series"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="3dp"
				android:layout_marginRight="3dp"
				android:paddingLeft="5dp"
				android:paddingRight="5dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_weight="1">
				<TextView
					android:id="@+id/textview95"
					android:layout_width="wrap_content"
					android:layout_height="30dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="سریال‌ها"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
				<ImageView
					android:id="@+id/imageview60"
					android:layout_width="15dp"
					android:layout_height="15dp"
					android:layout_marginLeft="3dp"
					android:src="@drawable/ic_cancel_grey"
					android:scaleType="fitCenter" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/lin_movie"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_weight="1">
				<TextView
					android:id="@+id/textview96"
					android:layout_width="wrap_content"
					android:layout_height="30dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="فیلم‌ها"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
				<ImageView
					android:id="@+id/imageview61"
					android:layout_width="15dp"
					android:layout_height="15dp"
					android:layout_marginLeft="3dp"
					android:src="@drawable/ic_cancel_grey"
					android:scaleType="fitCenter" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview47"
				android:layout_width="wrap_content"
				android:layout_height="30dp"
				android:layout_marginRight="5dp"
				android:gravity="center_vertical"
				android:text="فاکس فیلم"
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:layout_weight="1" />
			<LinearLayout
				android:id="@+id/linear88"
				android:layout_width="30dp"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:stateListAnimator="@anim/alpha_animator">
				<ImageView
					android:id="@+id/imageview39"
					android:layout_width="25dp"
					android:layout_height="25dp"
					android:src="@drawable/next1"
					android:scaleType="fitCenter"
					android:rotation="270"
					android:layout_gravity="center_horizontal|center_vertical" />
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
</LinearLayout>
