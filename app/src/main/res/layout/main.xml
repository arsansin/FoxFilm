<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear43"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#0F1620"
		android:orientation="vertical">
		<RelativeLayout
			android:id="@+id/relativelayout1"
			android:layout_width="match_parent"
			android:layout_height="match_parent">
			<LinearLayout
				android:id="@+id/linear26"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/main0"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="horizontal"
					android:layout_weight="1">
					<EditText
						android:id="@+id/edittext1"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:padding="8dp"
						android:textSize="12sp"
						android:hint="Edit Text" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:background="#0F1620"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear4"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="5dp"
						android:layout_marginRight="5dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:layout_weight="1">
						<LinearLayout
							android:id="@+id/lActivity4"
							android:layout_width="match_parent"
							android:layout_height="38dp"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1"
							android:stateListAnimator="@anim/alpha_animator">
							<de.hdodenhof.circleimageview.CircleImageView
								android:id="@+id/circleimageview1"
								android:layout_width="23dp"
								android:layout_height="23dp"
								android:src="@drawable/images2"
								app:civ_border_width="0dp"
								app:civ_border_color="#008DCD"
								app:civ_circle_background_color="#FFFFFF"
								app:civ_border_overlay="true" />
						</LinearLayout>
						<TextView
							android:id="@+id/setting_txt"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="حساب من"
							android:textSize="12sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear25"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:layout_marginRight="5dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:layout_weight="1">
						<LinearLayout
							android:id="@+id/lActivity3"
							android:layout_width="match_parent"
							android:layout_height="38dp"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1"
							android:stateListAnimator="@anim/alpha_animator">
							<ImageView
								android:id="@+id/download_img"
								android:layout_width="23dp"
								android:layout_height="23dp"
								android:src="@drawable/jhfftg6"
								android:scaleType="fitCenter" />
						</LinearLayout>
						<TextView
							android:id="@+id/download_txt"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="جستجو"
							android:textSize="12sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:layout_marginRight="5dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:layout_weight="1">
						<LinearLayout
							android:id="@+id/lActivity2"
							android:layout_width="match_parent"
							android:layout_height="38dp"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1"
							android:stateListAnimator="@anim/alpha_animator">
							<ImageView
								android:id="@+id/seen_img"
								android:layout_width="20dp"
								android:layout_height="20dp"
								android:src="@drawable/apps_24"
								android:scaleType="fitCenter" />
						</LinearLayout>
						<TextView
							android:id="@+id/seen_text"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="دسته بندی"
							android:textSize="12sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear7"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:layout_marginRight="5dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:layout_weight="1">
						<LinearLayout
							android:id="@+id/lActivity1"
							android:layout_width="match_parent"
							android:layout_height="38dp"
							android:background="#FF8E2D"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1"
							android:stateListAnimator="@anim/alpha_animator">
							<ImageView
								android:id="@+id/home_img"
								android:layout_width="23dp"
								android:layout_height="23dp"
								android:src="@drawable/films_24"
								android:scaleType="fitCenter" />
						</LinearLayout>
						<TextView
							android:id="@+id/home_txt"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="صفحه اصلی"
							android:textSize="12sp"
							android:textStyle="bold"
							android:textColor="#FF8E2D" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear27"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear28"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="70dp"
					android:gravity="right|bottom"
					android:orientation="horizontal"
					android:layout_weight="1">
					<LinearLayout
						android:id="@+id/linear39"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginRight="10dp"
						android:layout_marginBottom="30dp"
						android:padding="5dp"
						android:background="#FFFFFF"
						android:gravity="right|center_vertical"
						android:orientation="vertical"
						android:layout_gravity="right|bottom"
						android:stateListAnimator="@animator/click_zoom">
						<LinearLayout
							android:id="@+id/linear42"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="right|center_vertical"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/linear41"
								android:layout_width="wrap_content"
								android:layout_height="50dp"
								android:paddingLeft="20dp"
								android:paddingRight="20dp"
								android:background="#FFFFFF"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview2"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="5dp"
									android:text=" دریافت اطلاعات فیلم با آیدی"
									android:textSize="14sp"
									android:textStyle="bold"
									android:textColor="#000000" />
								<ImageView
									android:id="@+id/imageview7"
									android:layout_width="25dp"
									android:layout_height="30dp"
									android:layout_marginLeft="5dp"
									android:src="@drawable/id_instgram"
									android:scaleType="fitCenter" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear40"
								android:layout_width="wrap_content"
								android:layout_height="50dp"
								android:layout_marginTop="5dp"
								android:layout_marginBottom="5dp"
								android:paddingLeft="20dp"
								android:paddingRight="20dp"
								android:background="#FFFFFF"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview1"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="5dp"
									android:text="جستجوی پیشرفته"
									android:textSize="14sp"
									android:textStyle="bold"
									android:textColor="#000000" />
								<ImageView
									android:id="@+id/imageview6"
									android:layout_width="25dp"
									android:layout_height="30dp"
									android:layout_marginLeft="5dp"
									android:src="@drawable/jhfftg6"
									android:scaleType="fitCenter" />
							</LinearLayout>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear37"
							android:layout_width="55dp"
							android:layout_height="55dp"
							android:background="#FFFFFF"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical">
							<ImageView
								android:id="@+id/imageview5"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:src="@drawable/search_24"
								android:scaleType="fitCenter" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</RelativeLayout>
	</LinearLayout>
</LinearLayout>
