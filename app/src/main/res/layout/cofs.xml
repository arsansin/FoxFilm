<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear106"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<LinearLayout
			android:id="@+id/linear105"
			android:layout_width="wrap_content"
			android:layout_height="155dp"
			android:padding="15dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:rotation="180"
			android:layout_gravity="center_horizontal|center_vertical">
			<ImageView
				android:id="@+id/imageview45"
				android:focusable="false"
				android:layout_width="25dp"
				android:layout_height="25dp"
				android:src="@drawable/b3v"
				android:scaleType="fitCenter" />
			<TextView
				android:id="@+id/name_setar"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="8dp"
				android:paddingTop="8dp"
				android:paddingRight="8dp"
				android:paddingBottom="4dp"
				android:text="محمد رضا شریفی نیا"
				android:textSize="14sp"
				android:textColor="#FFFFFF" />
			<TextView
				android:id="@+id/ennsnesetar"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="8dp"
				android:paddingRight="8dp"
				android:paddingBottom="8dp"
				android:text="name bazigar"
				android:textSize="14sp"
				android:textColor="#FFFFFF" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear107"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear5"
				android:layout_width="100dp"
				android:layout_height="wrap_content"
				android:gravity="right|center_vertical"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical">
				<TextView
					android:id="@+id/name"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="4dp"
					android:gravity="right|center_vertical"
					android:text="TextView"
					android:textSize="12sp"
					android:textColor="#FFFFFF"
					android:singleLine="true"
					android:rotation="180"
					android:layout_gravity="right|center_vertical" />
			</LinearLayout>
			<RelativeLayout
				android:id="@+id/linear2"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="5dp"
				android:layout_marginRight="5dp"
				android:gravity="center_horizontal|top|bottom"
				android:orientation="vertical"
				android:rotation="180"
				android:layout_gravity="center_horizontal|center_vertical"
				android:stateListAnimator="@anim/alpha_animator">
				<ImageView
					android:id="@+id/imageview1"
					android:focusable="false"
					android:layout_width="100dp"
					android:layout_height="175dp"
					android:src="@drawable/shaderbottom"
					android:scaleType="fitXY" />
				<LinearLayout
					android:id="@+id/linear3"
					android:layout_width="100dp"
					android:layout_height="175dp"
					android:padding="8dp"
					android:gravity="right|bottom"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:orientation="horizontal"
						android:layout_weight="1" />
					<LinearLayout
						android:id="@+id/linear4"
						android:layout_width="25dp"
						android:layout_height="25dp"
						android:background="#000000"
						android:gravity="right|bottom"
						android:orientation="horizontal">
						<ImageView
							android:id="@+id/imageview2"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_margin="5dp"
							android:src="@drawable/age_group_5"
							android:scaleType="fitCenter" />
					</LinearLayout>
				</LinearLayout>
			</RelativeLayout>
		</LinearLayout>
	</LinearLayout>
	<TextView
		android:id="@+id/num"
		android:focusable="false"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:padding="8dp"
		android:text="TextView"
		android:textSize="12sp"
		android:textColor="#000000" />
</LinearLayout>
