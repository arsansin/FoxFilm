<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<RelativeLayout
		android:id="@+id/linear2"
		android:layout_width="100dp"
		android:layout_height="wrap_content"
		android:layout_marginLeft="5dp"
		android:layout_marginRight="5dp"
		android:gravity="center_horizontal|top|bottom"
		android:orientation="vertical"
		android:layout_gravity="center_horizontal|center_vertical"
		android:stateListAnimator="@anim/alpha_animator">
		<ImageView
			android:id="@+id/imageview1"
			android:focusable="false"
			android:layout_width="100dp"
			android:layout_height="175dp"
			android:src="@drawable/shaderbottom"
			android:scaleType="fitXY"
			android:layout_weight="1" />
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="100dp"
			android:layout_height="175dp"
			android:padding="8dp"
			android:gravity="right|bottom"
			android:orientation="vertical"
			android:layout_weight="1">
			<TextView
				android:id="@+id/textview1"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="4dp"
				android:paddingRight="4dp"
				android:background="#FF1744"
				android:text="قسمت جدید"
				android:textSize="10sp"
				android:textColor="#FFFFFF"
				android:layout_gravity="center_horizontal|center_vertical" />
			<LinearLayout
				android:id="@+id/linear6"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal"
				android:layout_weight="1" />
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="25dp"
				android:layout_height="25dp"
				android:background="#000000"
				android:gravity="right|bottom"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/imageview2"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:src="@drawable/age_group_5"
					android:scaleType="fitCenter" />
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
	<LinearLayout
		android:id="@+id/linear5"
		android:layout_width="100dp"
		android:layout_height="40dp"
		android:gravity="right|top"
		android:orientation="horizontal"
		android:layout_gravity="center_horizontal|center_vertical">
		<TextView
			android:id="@+id/name"
			android:focusable="false"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="4dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="TextView"
			android:textSize="12sp"
			android:textColor="#FFFFFF"
			android:singleLine="true"
			android:layout_gravity="center_horizontal|center_vertical" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/null_1"
		android:layout_width="105dp"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:layout_gravity="center_horizontal|center_vertical">
		<LinearLayout
			android:id="@+id/linear7"
			android:layout_width="100dp"
			android:layout_height="175dp"
			android:layout_marginLeft="5dp"
			android:layout_marginRight="5dp"
			android:padding="8dp"
			android:background="#1D2733"
			android:gravity="right|bottom"
			android:orientation="vertical"
			android:layout_gravity="center_horizontal|center_vertical"
			android:layout_weight="1" />
	</LinearLayout>
	<TextView
		android:id="@+id/num"
		android:focusable="false"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:padding="8dp"
		android:text="TextView"
		android:textSize="12sp"
		android:textColor="#000000" />
</LinearLayout>
