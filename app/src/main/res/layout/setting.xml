<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#0F1620"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear65"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="10dp"
			android:paddingTop="8dp"
			android:paddingRight="10dp"
			android:paddingBottom="8dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/love"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp"
				android:text="0"
				android:textSize="12sp"
				android:textColor="#000000" />
			<TextView
				android:id="@+id/cuple"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp"
				android:text="0"
				android:textSize="12sp"
				android:textColor="#000000" />
			<LinearLayout
				android:id="@+id/linear89"
				android:layout_width="30dp"
				android:layout_height="30dp"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical" />
			<TextView
				android:id="@+id/textview3"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="5dp"
				android:padding="4dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="شخصی سازی"
				android:textSize="20sp"
				android:textStyle="bold"
				android:textColor="#ECEFF1"
				android:singleLine="true"
				android:layout_weight="1" />
			<LinearLayout
				android:id="@+id/linear90"
				android:layout_width="30dp"
				android:layout_height="30dp"
				android:background="#1D2733"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:stateListAnimator="@anim/alpha_animator">
				<ImageView
					android:id="@+id/setting"
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_left_white"
					android:scaleType="fitCenter"
					android:rotation="180" />
			</LinearLayout>
		</LinearLayout>
		<ScrollView
			android:id="@+id/vscroll1"
			android:layout_width="match_parent"
			android:layout_height="match_parent">
			<LinearLayout
				android:id="@+id/linear97"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear2"
					android:layout_width="match_parent"
					android:layout_height="55dp"
					android:layout_marginLeft="10dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="10dp"
					android:layout_marginBottom="5dp"
					android:background="#1D2733"
					android:gravity="right|center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/imageview7"
						android:layout_width="15dp"
						android:layout_height="15dp"
						android:layout_marginLeft="8dp"
						android:src="@drawable/next1"
						android:scaleType="fitCenter"
						android:rotation="180" />
					<TextView
						android:id="@+id/textview1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginRight="10dp"
						android:text="انتخاب پخش کننده"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:layout_weight="1" />
					<ImageView
						android:id="@+id/imageview1"
						android:layout_width="25dp"
						android:layout_height="25dp"
						android:layout_marginRight="10dp"
						android:src="@drawable/icon_ondemand_video_round"
						android:scaleType="fitCenter" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear91"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginRight="10dp"
					android:layout_marginBottom="5dp"
					android:background="#1D2733"
					android:gravity="top"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear92"
						android:layout_width="match_parent"
						android:layout_height="53dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview5"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:text="(مناسب برای کاهش مصرف اینترنت)"
							android:textSize="10sp"
							android:textColor="#9E9E9E" />
						<TextView
							android:id="@+id/textview4"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginRight="10dp"
							android:text="تصاویر"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
						<ImageView
							android:id="@+id/imageview2"
							android:layout_width="25dp"
							android:layout_height="25dp"
							android:layout_marginRight="10dp"
							android:src="@drawable/icon_photo_size_select_large_round"
							android:scaleType="fitCenter" />
					</LinearLayout>
					<RelativeLayout
						android:id="@+id/relativelayout1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:layout_marginTop="10dp"
						android:layout_marginRight="10dp"
						android:layout_gravity="center_horizontal|center_vertical"
						android:stateListAnimator="@anim/alpha_animator">
						<ImageView
							android:id="@+id/imageview3"
							android:layout_width="100dp"
							android:layout_height="175dp"
							android:src="@drawable/nul"
							android:scaleType="fitXY" />
						<LinearLayout
							android:id="@+id/linear3"
							android:layout_width="100dp"
							android:layout_height="175dp"
							android:padding="8dp"
							android:gravity="right|bottom"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview6"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:paddingLeft="4dp"
								android:paddingRight="4dp"
								android:background="#448AFF"
								android:text="کیفیت 10%"
								android:textSize="10sp"
								android:textColor="#FFFFFF"
								android:layout_gravity="center_horizontal|center_vertical" />
							<LinearLayout
								android:id="@+id/linear6"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:orientation="horizontal"
								android:layout_weight="1" />
							<LinearLayout
								android:id="@+id/linear4"
								android:layout_width="25dp"
								android:layout_height="25dp"
								android:background="#000000"
								android:gravity="right|bottom"
								android:orientation="horizontal">
								<ImageView
									android:id="@+id/imageview4"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_margin="7dp"
									android:src="@drawable/age_group_5"
									android:scaleType="fitCenter" />
							</LinearLayout>
						</LinearLayout>
					</RelativeLayout>
					<LinearLayout
						android:id="@+id/linear5"
						android:layout_width="100dp"
						android:layout_height="wrap_content"
						android:layout_marginBottom="10dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical">
						<TextView
							android:id="@+id/name"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="4dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="باب اسفنجی"
							android:textSize="12sp"
							android:textColor="#FFFFFF"
							android:singleLine="true"
							android:layout_gravity="right|center_vertical" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear95"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="5dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<SeekBar
							android:id="@+id/seekbar2"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:rotation="180"
							android:progress="1"
							android:max="3"
							android:layout_weight="1"
							android:progressDrawable="@drawable/seekbar_progress"
							android:thumb="@android:color/transparent"
							android:stateListAnimator="@null"/> />
						<TextView
							android:id="@+id/textview8"
							android:layout_width="45dp"
							android:layout_height="wrap_content"
							android:layout_marginLeft="10dp"
							android:layout_marginRight="10dp"
							android:text="کیفیت"
							android:textSize="14sp"
							android:textColor="#FFFFFF" />
					</LinearLayout>
					<TextView
						android:id="@+id/textview9"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:layout_marginRight="10dp"
						android:padding="8dp"
						android:text="• برای افزایش سرعت برنامه و کاهش مصرف اینترنت، مناسب‌تر است که درصد کیفیت را کاهش دهید."
						android:textSize="12sp"
						android:textColor="#9E9E9E" />
					<LinearLayout
						android:id="@+id/linear94"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="8dp"
						android:padding="5dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<SeekBar
							android:id="@+id/seekbar1"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:rotation="180"
							android:progress="10"
							android:max="30"
							android:layout_weight="1"
							android:progressDrawable="@drawable/seekbar_progress"
							android:thumb="@android:color/transparent"
							android:stateListAnimator="@null"/> />
						<TextView
							android:id="@+id/textview7"
							android:layout_width="45dp"
							android:layout_height="wrap_content"
							android:layout_marginLeft="10dp"
							android:layout_marginRight="10dp"
							android:text="گوشه"
							android:textSize="14sp"
							android:textColor="#FFFFFF" />
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear96"
					android:layout_width="match_parent"
					android:layout_height="55dp"
					android:layout_marginLeft="10dp"
					android:layout_marginRight="10dp"
					android:layout_marginBottom="5dp"
					android:background="#1D2733"
					android:gravity="right|center_vertical"
					android:orientation="horizontal">
					<Switch
						android:id="@+id/switch1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:textSize="12sp"
						android:textColor="#000000"
						android:rotation="180" />
					<TextView
						android:id="@+id/textview10"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginRight="10dp"
						android:text="نام ویدیو ها"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:layout_weight="1" />
					<ImageView
						android:id="@+id/imageview9"
						android:layout_width="25dp"
						android:layout_height="25dp"
						android:layout_marginRight="10dp"
						android:src="@drawable/icon_title_round"
						android:scaleType="fitCenter" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear98"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:layout_marginRight="10dp"
					android:layout_marginBottom="5dp"
					android:background="#1D2733"
					android:gravity="top"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear99"
						android:layout_width="match_parent"
						android:layout_height="53dp"
						android:gravity="right|center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview13"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginRight="10dp"
							android:text="تم برنامه"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
						<ImageView
							android:id="@+id/imageview10"
							android:layout_width="25dp"
							android:layout_height="25dp"
							android:layout_marginRight="10dp"
							android:src="@drawable/icon_invert_colors_round"
							android:scaleType="fitCenter" />
					</LinearLayout>
					<HorizontalScrollView
						android:id="@+id/hscroll1"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginLeft="8dp"
						android:layout_marginRight="8dp"
						android:layout_marginBottom="8dp"
						android:layout_gravity="center_horizontal|center_vertical">
						<LinearLayout
							android:id="@+id/linear102"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<LinearLayout
								android:id="@+id/linear106"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:padding="5dp"
								android:orientation="vertical">
								<LinearLayout
									android:id="@+id/color1"
									android:layout_width="50dp"
									android:layout_height="50dp"
									android:background="#FF8E2D"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:stateListAnimator="@anim/alpha_animator">
									<ImageView
										android:id="@+id/tick1"
										android:layout_width="25dp"
										android:layout_height="25dp"
										android:src="@drawable/iuo_10"
										android:scaleType="fitCenter"
										android:layout_gravity="center_horizontal|center_vertical"
										android:stateListAnimator="@animator/click_zoom" />
								</LinearLayout>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear108"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:layout_marginLeft="5dp"
								android:padding="5dp"
								android:orientation="vertical">
								<LinearLayout
									android:id="@+id/color2"
									android:layout_width="50dp"
									android:layout_height="50dp"
									android:background="#536DFE"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:layout_gravity="center_horizontal|center_vertical"
									android:stateListAnimator="@anim/alpha_animator">
									<ImageView
										android:id="@+id/tick2"
										android:layout_width="25dp"
										android:layout_height="25dp"
										android:src="@drawable/iuo_10"
										android:scaleType="fitCenter"
										android:layout_gravity="center_horizontal|center_vertical"
										android:stateListAnimator="@animator/click_zoom" />
								</LinearLayout>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear110"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:layout_marginLeft="5dp"
								android:padding="5dp"
								android:orientation="vertical">
								<LinearLayout
									android:id="@+id/color3"
									android:layout_width="50dp"
									android:layout_height="50dp"
									android:background="#FF5252"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:stateListAnimator="@anim/alpha_animator">
									<ImageView
										android:id="@+id/tick3"
										android:layout_width="25dp"
										android:layout_height="25dp"
										android:src="@drawable/iuo_10"
										android:scaleType="fitCenter"
										android:layout_gravity="center_horizontal|center_vertical"
										android:stateListAnimator="@animator/click_zoom" />
								</LinearLayout>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear112"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:layout_marginLeft="5dp"
								android:padding="5dp"
								android:orientation="vertical">
								<LinearLayout
									android:id="@+id/color4"
									android:layout_width="50dp"
									android:layout_height="50dp"
									android:background="#FF4081"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:stateListAnimator="@anim/alpha_animator">
									<ImageView
										android:id="@+id/tick4"
										android:layout_width="25dp"
										android:layout_height="25dp"
										android:src="@drawable/iuo_10"
										android:scaleType="fitCenter"
										android:layout_gravity="center_horizontal|center_vertical"
										android:stateListAnimator="@animator/click_zoom" />
								</LinearLayout>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear114"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:layout_marginLeft="5dp"
								android:padding="5dp"
								android:orientation="vertical">
								<LinearLayout
									android:id="@+id/color5"
									android:layout_width="50dp"
									android:layout_height="50dp"
									android:background="#7C4DFF"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:stateListAnimator="@anim/alpha_animator">
									<ImageView
										android:id="@+id/tick5"
										android:layout_width="25dp"
										android:layout_height="25dp"
										android:src="@drawable/iuo_10"
										android:scaleType="fitCenter"
										android:layout_gravity="center_horizontal|center_vertical"
										android:stateListAnimator="@animator/click_zoom" />
								</LinearLayout>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear116"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:layout_marginLeft="5dp"
								android:padding="5dp"
								android:orientation="vertical">
								<LinearLayout
									android:id="@+id/color6"
									android:layout_width="50dp"
									android:layout_height="50dp"
									android:background="#00C853"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:stateListAnimator="@anim/alpha_animator">
									<ImageView
										android:id="@+id/tick6"
										android:layout_width="25dp"
										android:layout_height="25dp"
										android:src="@drawable/iuo_10"
										android:scaleType="fitCenter"
										android:layout_gravity="center_horizontal|center_vertical"
										android:stateListAnimator="@animator/click_zoom" />
								</LinearLayout>
							</LinearLayout>
						</LinearLayout>
					</HorizontalScrollView>
				</LinearLayout>
			</LinearLayout>
		</ScrollView>
	</LinearLayout>
</LinearLayout>
