<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:background="#0F1620"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical">
		<TextView
			android:id="@+id/textview1"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="در حال حاضر در دسترس نیست."
			android:textSize="14sp"
			android:textStyle="bold"
			android:textColor="#FFFFFF" />
		<TextView
			android:id="@+id/textview2"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="برای دانلود فیلم و سریال از (دانلود با ADM) استفاده کنید "
			android:textSize="11sp"
			android:textColor="#E0E0E0" />
		<LinearLayout
			android:id="@+id/adm_480"
			android:layout_width="wrap_content"
			android:layout_height="35dp"
			android:layout_marginTop="8dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp"
			android:background="#448AFF"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal"
			android:stateListAnimator="@anim/alpha_animator">
			<ImageView
				android:id="@+id/imageview8"
				android:layout_width="20dp"
				android:layout_height="23dp"
				android:layout_marginRight="5dp"
				android:src="@drawable/rtttyyyt"
				android:scaleType="fitCenter" />
			<TextView
				android:id="@+id/textview8"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="دانلود با ADM"
				android:textSize="12sp"
				android:textColor="#FFFFFF" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
