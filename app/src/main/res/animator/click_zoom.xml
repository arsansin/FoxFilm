<?xml version="1.0" encoding="utf-8"?>
<!-- Reconstruction of the lost Sketchware animator "کلیک_بزرگنمایی" (click-zoom):
     a state list animator that slightly enlarges the view while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                    android:propertyName="scaleX"
                    android:valueTo="1.1"
                    android:duration="100" />
            <objectAnimator
                    android:propertyName="scaleY"
                    android:valueTo="1.1"
                    android:duration="100" />
        </set>
    </item>
    <item android:state_pressed="false">
        <set>
            <objectAnimator
                    android:propertyName="scaleX"
                    android:valueTo="1"
                    android:duration="100" />
            <objectAnimator
                    android:propertyName="scaleY"
                    android:valueTo="1"
                    android:duration="100" />
        </set>
    </item>
</selector>
